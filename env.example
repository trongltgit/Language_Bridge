# Copy to .env and fill in. Never commit .env.
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=choose-a-strong-passphrase   # creates the first admin on first start
REQUIRE_MFA=true                            # enforce MFA for Admin and Translator
ANTHROPIC_API_KEY=                          # empty = AI drafts disabled, translators work from source
AI_MODEL=claude-sonnet-5-5
AI_VENDOR_BAA=false                         # set true ONLY after a signed BAA / zero-retention agreement (gates medical AI use)
PAYMENTS_MODE=simulated                     # replace billing.charge() with Stripe / VNPay / MoMo before real money
COMMISSION_PCT=20
MEMBERSHIP_USD=15
TRANSCRIPT_RETENTION_DAYS=30
SOURCE_RETENTION_DAYS=30
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
